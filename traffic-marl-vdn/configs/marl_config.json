{
    "sumo_config_path": "sumo_configs/3junctions.sumocfg",
    "use_gui": true,
    "num_episodes": 50,
    "max_steps_per_episode": 3600,
    "save_frequency": 10,
    "log_frequency": 1,
    "control_modes": {
        "default_mode": "marl",
        "fixed_green_steps": 20,
        "dashboard_enabled": true,
        "dashboard_host": "localhost",
        "dashboard_port": 8765,
        "stream_sumo_gui": true,
        "stream_frame_interval_steps": 20,
        "stream_frame_width": 1950,
        "stream_frame_height": 1100
    },
    
    "agent_config": {
        "learning_rate": 0.0001,
        "gamma": 0.95,               
        "epsilon_start": 1.0,
        "epsilon_min": 0.05,
        "epsilon_decay": 0.99999,       
        "buffer_size": 10000,
        "central_buffer_size": 50000,
        "batch_size": 32,            
        "target_update_freq": 50,    
        "enable_communication": true,
        "neighbor_feature_dim": 8,
        "grad_clip": 1.0,
        "num_actions": 5
    },
    "env_config": {
        "enable_data_injection": true,
        "injection_poll_interval": 1.0,
        "min_green_time": 50,
        "max_green_time": 150,
        "yellow_time": 10,
        "green_extension": 40,
        "min_ped_green_time": 12,
        "max_ped_green_time": 45,
        "top_k_lanes": 6,
        "vehicle_priority_weights": {
            "bike": 0.8,
            "real_car": 1.0,
            "car": 1.0,
            "auto": 1.2,
            "bus": 2.2,
            "truck": 2.4,
            "lorry": 2.5,
            "ambulance": 8.0,
            "police": 6.8,
            "firetruck": 8.2
        }
    }
}