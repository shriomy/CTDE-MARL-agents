<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <!-- Vehicle types -->
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="5.0" maxSpeed="50.0" color="1,0,0"/>
    <vType id="truck" accel="1.2" decel="4.0" sigma="0.5" length="7.5" maxSpeed="40.0" color="0.5,0.5,0.5"/>
    <vType id="pedestrian" vClass="pedestrian" maxSpeed="1.34" color="0,1,0"/>
    
    <!-- ===== BOUNDARY ENTRY POINTS (where vehicles are generated) ===== -->
    <!-- J1: West boundary (J1_west) - vehicles enter via J1_east_in -->
    <!-- J2: North boundary (J2_north) - vehicles enter via J2_north_in -->
    <!-- J3: North boundary (J3_north) - vehicles enter via J3_north_in -->
    <!-- J3: East boundary (J3_east) - vehicles enter via J3_east_in -->
    <!-- J3: South boundary (J3_south) - vehicles enter via J3_south_in -->
    
    <!-- ===== J1 - PEDESTRIAN CROSSING (just a through point) ===== -->
    <!-- No turns at J1, just straight through -->
    
    <!-- ===== ROUTES STARTING FROM WEST BOUNDARY (J1_west) ===== -->
    <!-- From West, going all the way to East boundary -->
    <route id="west_to_east_full" edges="J1_east_in connect_J1_J2 connect_J2_J3 J3_east_out"/>
    
    <!-- From West, going to J2 North boundary -->
    <route id="west_to_J2_north" edges="J1_east_in connect_J1_J2 J2_north_out"/>
    
    <!-- From West, going to J3 North boundary -->
    <route id="west_to_J3_north" edges="J1_east_in connect_J1_J2 connect_J2_J3 J3_north_out"/>
    
    <!-- From West, going to J3 South boundary -->
    <route id="west_to_J3_south" edges="J1_east_in connect_J1_J2 connect_J2_J3 J3_south_out"/>
    
    <!-- ===== ROUTES STARTING FROM J2 NORTH BOUNDARY (J2_north) ===== -->
    <!-- From J2 North, going to West boundary -->
    <route id="J2_north_to_west" edges="J2_north_in connect_J2_J1 J1_west_out"/>
    
    <!-- From J2 North, going to East boundary (via J3) -->
    <route id="J2_north_to_east" edges="J2_north_in connect_J2_J3 J3_east_out"/>
    
    <!-- From J2 North, going to J3 North boundary -->
    <route id="J2_north_to_J3_north" edges="J2_north_in connect_J2_J3 J3_north_out"/>
    
    <!-- From J2 North, going to J3 South boundary -->
    <route id="J2_north_to_J3_south" edges="J2_north_in connect_J2_J3 J3_south_out"/>
    
    <!-- ===== ROUTES STARTING FROM J3 NORTH BOUNDARY (J3_north) ===== -->
    <!-- From J3 North, going to South boundary -->
    <route id="J3_north_to_south" edges="J3_north_in J3_south_out"/>
    
    <!-- From J3 North, going to East boundary -->
    <route id="J3_north_to_east" edges="J3_north_in J3_east_out"/>
    
    <!-- From J3 North, going to West boundary (via J2 and J1) -->
    <route id="J3_north_to_west" edges="J3_north_in connect_J3_J2 connect_J2_J1 J1_west_out"/>
    
    <!-- From J3 North, going to J2 North boundary -->
    <route id="J3_north_to_J2_north" edges="J3_north_in connect_J3_J2 J2_north_out"/>
    
    <!-- ===== ROUTES STARTING FROM J3 EAST BOUNDARY (J3_east) ===== -->
    <!-- From East, going to West boundary (full route) -->
    <route id="east_to_west_full" edges="J3_east_in connect_J3_J2 connect_J2_J1 J1_west_out"/>
    
    <!-- From East, going to J2 North boundary -->
    <route id="east_to_J2_north" edges="J3_east_in connect_J3_J2 J2_north_out"/>
    
    <!-- From East, going to J3 North boundary -->
    <route id="east_to_J3_north" edges="J3_east_in J3_north_out"/>
    
    <!-- From East, going to J3 South boundary -->
    <route id="east_to_J3_south" edges="J3_east_in J3_south_out"/>
    
    <!-- ===== ROUTES STARTING FROM J3 SOUTH BOUNDARY (J3_south) ===== -->
    <!-- From South, going to North boundary -->
    <route id="south_to_north" edges="J3_south_in J3_north_out"/>
    
    <!-- From South, going to East boundary -->
    <route id="south_to_east" edges="J3_south_in J3_east_out"/>
    
    <!-- From South, going to West boundary (via J2 and J1) -->
    <route id="south_to_west" edges="J3_south_in connect_J3_J2 connect_J2_J1 J1_west_out"/>
    
    <!-- From South, going to J2 North boundary -->
    <route id="south_to_J2_north" edges="J3_south_in connect_J3_J2 J2_north_out"/>
    
    <!-- ===== VEHICLE FLOWS - EACH FLOW STARTS AT A BOUNDARY ===== -->
    
    <!-- Flows from WEST boundary (J1_west) -->
    <flow id="flow_west_to_east" type="car" route="west_to_east_full" begin="0" end="3600" period="8"/>
    <flow id="flow_west_to_J2_north" type="car" route="west_to_J2_north" begin="0" end="3600" period="15"/>
    <flow id="flow_west_to_J3_north" type="car" route="west_to_J3_north" begin="0" end="3600" period="20"/>
    <flow id="flow_west_to_J3_south" type="car" route="west_to_J3_south" begin="0" end="3600" period="20"/>
    
    <!-- Flows from J2 NORTH boundary -->
    <flow id="flow_J2_north_to_west" type="car" route="J2_north_to_west" begin="0" end="3600" period="10"/>
    <flow id="flow_J2_north_to_east" type="car" route="J2_north_to_east" begin="0" end="3600" period="10"/>
    <flow id="flow_J2_north_to_J3_north" type="car" route="J2_north_to_J3_north" begin="0" end="3600" period="15"/>
    <flow id="flow_J2_north_to_J3_south" type="car" route="J2_north_to_J3_south" begin="0" end="3600" period="15"/>
    
    <!-- Flows from J3 NORTH boundary -->
    <flow id="flow_J3_north_to_south" type="car" route="J3_north_to_south" begin="0" end="3600" period="8"/>
    <flow id="flow_J3_north_to_east" type="car" route="J3_north_to_east" begin="0" end="3600" period="12"/>
    <flow id="flow_J3_north_to_west" type="car" route="J3_north_to_west" begin="0" end="3600" period="15"/>
    <flow id="flow_J3_north_to_J2_north" type="car" route="J3_north_to_J2_north" begin="0" end="3600" period="15"/>
    
    <!-- Flows from J3 EAST boundary -->
    <flow id="flow_east_to_west" type="car" route="east_to_west_full" begin="0" end="3600" period="8"/>
    <flow id="flow_east_to_J2_north" type="car" route="east_to_J2_north" begin="0" end="3600" period="12"/>
    <flow id="flow_east_to_J3_north" type="car" route="east_to_J3_north" begin="0" end="3600" period="15"/>
    <flow id="flow_east_to_J3_south" type="car" route="east_to_J3_south" begin="0" end="3600" period="15"/>
    
    <!-- Flows from J3 SOUTH boundary -->
    <flow id="flow_south_to_north" type="car" route="south_to_north" begin="0" end="3600" period="8"/>
    <flow id="flow_south_to_east" type="car" route="south_to_east" begin="0" end="3600" period="12"/>
    <flow id="flow_south_to_west" type="car" route="south_to_west" begin="0" end="3600" period="15"/>
    <flow id="flow_south_to_J2_north" type="car" route="south_to_J2_north" begin="0" end="3600" period="15"/>
    
    <!-- ===== PEDESTRIAN FLOWS (unchanged) ===== -->
    <person id="ped_south_1" type="pedestrian" depart="5">
        <walk edges="J1_walk_south"/>
        <stop lane="J1_walk_south_0" duration="8"/>
        <walk edges="J1_crossing_edge J1_walk_north"/>
    </person>
    
    <person id="ped_south_2" type="pedestrian" depart="25">
        <walk edges="J1_walk_south"/>
        <stop lane="J1_walk_south_0" duration="10"/>
        <walk edges="J1_crossing_edge J1_walk_north"/>
    </person>
    
    <person id="ped_north_1" type="pedestrian" depart="15">
        <walk edges="J1_walk_north"/>
        <stop lane="J1_walk_north_0" duration="8"/>
        <walk edges="J1_crossing_edge J1_walk_south"/>
    </person>
    
    <person id="ped_north_2" type="pedestrian" depart="35">
        <walk edges="J1_walk_north"/>
        <stop lane="J1_walk_north_0" duration="10"/>
        <walk edges="J1_crossing_edge J1_walk_south"/>
    </person>
</routes>