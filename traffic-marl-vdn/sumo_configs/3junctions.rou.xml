<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <!-- Vehicle types -->
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="5.0" maxSpeed="50.0" color="1,0,0"/>
    <vType id="truck" accel="1.2" decel="4.0" sigma="0.5" length="7.5" maxSpeed="40.0" color="0.5,0.5,0.5"/>
    <vType id="pedestrian" vClass="pedestrian" maxSpeed="1.34" color="0,1,0"/>
    
    <!-- ===== J1 (PEDESTRIAN CROSSING) ===== -->
    <!-- At J1, vehicles only go straight (east-west or west-east) -->
    <route id="west_to_east" edges="J1_east_in connect_J1_J2 connect_J2_J3 J3_east_out"/>
    <route id="east_to_west" edges="J3_east_in connect_J3_J2 connect_J2_J1 J1_west_out"/>
    
    <!-- ===== J2 (3-WAY JUNCTION) ===== -->
    <!-- Vehicles from West (coming from J1) -->
    <route id="west_to_north_at_J2" edges="connect_J1_J2 J2_north_out"/>  <!-- West to North -->
    <route id="west_to_east_at_J2" edges="connect_J1_J2 connect_J2_J3 J3_east_out"/>  <!-- West to East (through J3) -->
    
    <!-- Vehicles from North -->
    <route id="north_to_west_at_J2" edges="J2_north_in connect_J2_J1 J1_west_out"/>  <!-- North to West -->
    <route id="north_to_east_at_J2" edges="J2_north_in connect_J2_J3 J3_east_out"/>  <!-- North to East (through J3) -->
    
    <!-- Vehicles from East (coming from J3) -->
    <route id="east_to_west_at_J2" edges="connect_J3_J2 connect_J2_J1 J1_west_out"/>  <!-- East to West -->
    <route id="east_to_north_at_J2" edges="connect_J3_J2 J2_north_out"/>  <!-- East to North -->
    
    <!-- ===== J3 (4-WAY JUNCTION) ===== -->
    <!-- Vehicles from West (coming from J2) -->
    <route id="west_to_north_at_J3" edges="connect_J2_J3 J3_north_out"/>  <!-- West to North -->
    <route id="west_to_south_at_J3" edges="connect_J2_J3 J3_south_out"/>  <!-- West to South -->
    <route id="west_to_east_at_J3" edges="connect_J2_J3 J3_east_out"/>  <!-- West to East (through) -->
    
    <!-- Vehicles from North -->
    <route id="north_to_west_at_J3" edges="J3_north_in connect_J3_J2 connect_J2_J1 J1_west_out"/>  <!-- North to West -->
    <route id="north_to_south_at_J3" edges="J3_north_in J3_south_out"/>  <!-- North to South -->
    <route id="north_to_east_at_J3" edges="J3_north_in J3_east_out"/>  <!-- North to East -->
    
    <!-- Vehicles from East -->
    <route id="east_to_west_at_J3" edges="J3_east_in connect_J3_J2 connect_J2_J1 J1_west_out"/>  <!-- East to West -->
    <route id="east_to_north_at_J3" edges="J3_east_in J3_north_out"/>  <!-- East to North -->
    <route id="east_to_south_at_J3" edges="J3_east_in J3_south_out"/>  <!-- East to South -->
    
    <!-- Vehicles from South -->
    <route id="south_to_west_at_J3" edges="J3_south_in connect_J3_J2 connect_J2_J1 J1_west_out"/>  <!-- South to West -->
    <route id="south_to_north_at_J3" edges="J3_south_in J3_north_out"/>  <!-- South to North -->
    <route id="south_to_east_at_J3" edges="J3_south_in J3_east_out"/>  <!-- South to East -->
    
    <!-- ===== VEHICLE FLOWS ===== -->
    <!-- Through traffic on main corridor -->
    <flow id="flow_west_east_main" type="car" route="west_to_east" begin="0" end="3600" period="10"/>
    <flow id="flow_east_west_main" type="car" route="east_to_west" begin="0" end="3600" period="10"/>
    
    <!-- J2 flows - West incoming -->
    <flow id="flow_west_north_J2" type="car" route="west_to_north_at_J2" begin="0" end="3600" period="15"/>
    <flow id="flow_west_east_J2" type="car" route="west_to_east_at_J2" begin="0" end="3600" period="12"/>
    
    <!-- J2 flows - North incoming -->
    <flow id="flow_north_west_J2" type="car" route="north_to_west_at_J2" begin="0" end="3600" period="15"/>
    <flow id="flow_north_east_J2" type="car" route="north_to_east_at_J2" begin="0" end="3600" period="12"/>
    
    <!-- J2 flows - East incoming -->
    <flow id="flow_east_west_J2" type="car" route="east_to_west_at_J2" begin="0" end="3600" period="12"/>
    <flow id="flow_east_north_J2" type="car" route="east_to_north_at_J2" begin="0" end="3600" period="15"/>
    
    <!-- J3 flows - West incoming -->
    <flow id="flow_west_north_J3" type="car" route="west_to_north_at_J3" begin="0" end="3600" period="18"/>
    <flow id="flow_west_south_J3" type="car" route="west_to_south_at_J3" begin="0" end="3600" period="18"/>
    <flow id="flow_west_east_J3" type="car" route="west_to_east_at_J3" begin="0" end="3600" period="15"/>
    
    <!-- J3 flows - North incoming -->
    <flow id="flow_north_west_J3" type="car" route="north_to_west_at_J3" begin="0" end="3600" period="18"/>
    <flow id="flow_north_south_J3" type="car" route="north_to_south_at_J3" begin="0" end="3600" period="15"/>
    <flow id="flow_north_east_J3" type="car" route="north_to_east_at_J3" begin="0" end="3600" period="18"/>
    
    <!-- J3 flows - East incoming -->
    <flow id="flow_east_west_J3" type="car" route="east_to_west_at_J3" begin="0" end="3600" period="15"/>
    <flow id="flow_east_north_J3" type="car" route="east_to_north_at_J3" begin="0" end="3600" period="18"/>
    <flow id="flow_east_south_J3" type="car" route="east_to_south_at_J3" begin="0" end="3600" period="18"/>
    
    <!-- J3 flows - South incoming -->
    <flow id="flow_south_west_J3" type="car" route="south_to_west_at_J3" begin="0" end="3600" period="18"/>
    <flow id="flow_south_north_J3" type="car" route="south_to_north_at_J3" begin="0" end="3600" period="15"/>
    <flow id="flow_south_east_J3" type="car" route="south_to_east_at_J3" begin="0" end="3600" period="18"/>
    
    <!-- ===== PEDESTRIAN FLOWS (unchanged) ===== -->
    <!-- Pedestrians using the walking areas and crossing -->
    <person id="ped_south_1" type="pedestrian" depart="5">
        <walk edges="J1_walk_south"/>
        <stop lane="J1_walk_south_0" duration="8"/>
        <walk edges="J1_crossing_edge J1_walk_north"/>
    </person>
    
    <person id="ped_south_2" type="pedestrian" depart="25">
        <walk edges="J1_walk_south"/>
        <stop lane="J1_walk_south_0" duration="10"/>
        <walk edges="J1_crossing_edge J1_walk_north"/>
    </person>
    
    <person id="ped_north_1" type="pedestrian" depart="15">
        <walk edges="J1_walk_north"/>
        <stop lane="J1_walk_north_0" duration="8"/>
        <walk edges="J1_crossing_edge J1_walk_south"/>
    </person>
    
    <person id="ped_north_2" type="pedestrian" depart="35">
        <walk edges="J1_walk_north"/>
        <stop lane="J1_walk_north_0" duration="10"/>
        <walk edges="J1_crossing_edge J1_walk_south"/>
    </person>
    
    <person id="ped_wait_south" type="pedestrian" depart="8">
        <walk edges="J1_walk_south"/>
        <stop lane="J1_walk_south_0" duration="30"/>
    </person>
    
    <person id="ped_wait_north" type="pedestrian" depart="18">
        <walk edges="J1_walk_north"/>
        <stop lane="J1_walk_north_0" duration="30"/>
    </person>
</routes>