<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/routes_file.xsd">

    <!-- =============================================================== -->
    <!-- VEHICLE TYPES -->
    <!-- =============================================================== -->
    
    <vType id="car" guiShape="passenger" accel="2.6" decel="4.5" sigma="0.2" length="5" minGap="2.5" maxSpeed="0.00625" speedFactor="1.0"/>
    <vType id="truck" guiShape="truck" accel="2.0" decel="4.0" sigma="0.2" length="10" minGap="3.0" maxSpeed="0.005" speedFactor="0.9"/>
    
    <!-- =============================================================== -->
    <!-- ROUTES FOR 2-WAY JUNCTION (J1_2way) -->
    <!-- =============================================================== -->
    
    <!-- J1: east-west crossing with passenger routes -->
    <route id="J1_west_to_east" edges="J1_east_in J1_east_out connect_J1_J2" color="blue"/>
    <route id="J1_east_to_west" edges="connect_J2_J1 J1_west_in J1_west_out" color="green"/>
    
    <!-- =============================================================== -->
    <!-- ROUTES FOR 3-WAY JUNCTION (J2_3way) -->
    <!-- main road continues west-east, branch to north -->
    <!-- =============================================================== -->
    <!-- West to East (through) -->
    <route id="J2_west_to_east" edges="connect_J1_J2 J2_west_in J2_east_out connect_J2_J3" color="blue"/>
    <!-- West to North -->
    <route id="J2_west_to_north" edges="connect_J1_J2 J2_west_in J2_north_out" color="blue"/>
    <!-- East to West (through) -->
    <route id="J2_east_to_west" edges="connect_J3_J2 J2_east_in J2_west_out connect_J2_J1" color="red"/>
    <!-- East to North -->
    <route id="J2_east_to_north" edges="connect_J3_J2 J2_east_in J2_north_out" color="red"/>
    <!-- North to West -->
    <route id="J2_north_to_west" edges="J2_north_in J2_west_out connect_J2_J1" color="green"/>
    <!-- North to East -->
    <route id="J2_north_to_east" edges="J2_north_in J2_east_out connect_J2_J3" color="green"/>
    
    <!-- =============================================================== -->
    <!-- ROUTES FOR 4-WAY JUNCTION (J3_4way) -->
    <!-- =============================================================== -->
    
    <!-- North incoming routes -->
    <route id="J3_north_to_south" edges="J3_north_in J3_south_out" color="blue"/>
    <route id="J3_north_to_east" edges="J3_north_in J3_east_out" color="blue"/>
    <route id="J3_north_to_west" edges="J3_north_in J3_west_out" color="blue"/>
    
    <!-- South incoming routes -->
    <route id="J3_south_to_north" edges="J3_south_in J3_north_out" color="green"/>
    <route id="J3_south_to_east" edges="J3_south_in J3_east_out" color="green"/>
    <route id="J3_south_to_west" edges="J3_south_in J3_west_out" color="green"/>
    
    <!-- East incoming routes -->
    <route id="J3_east_to_north" edges="J3_east_in J3_north_out" color="red"/>
    <route id="J3_east_to_south" edges="J3_east_in J3_south_out" color="red"/>
    <route id="J3_east_to_west" edges="J3_east_in J3_west_out" color="red"/>
    
    <!-- West incoming routes -->
    <route id="J3_west_to_north" edges="J3_west_in J3_north_out" color="orange"/>
    <route id="J3_west_to_south" edges="J3_west_in J3_south_out" color="orange"/>
    <route id="J3_west_to_east" edges="J3_west_in J3_east_out" color="orange"/>
    
    <!-- =============================================================== -->
    <!-- TRAFFIC DEMAND -->
    <!-- =============================================================== -->
    
    <!-- Main flows along the linear corridor -->
    <flow id="flow_J1_w2e" route="J1_west_to_east" vehsPerHour="20" begin="0" end="86400" type="car"/>
    <flow id="flow_J1_e2w" route="J1_east_to_west" vehsPerHour="20" begin="0" end="86400" type="car"/>
    
    <!-- J2 flows (including branch to north) -->
    <flow id="flow_J2_w2e" route="J2_west_to_east" vehsPerHour="20" begin="0" end="86400" type="car"/>
    <flow id="flow_J2_w2n" route="J2_west_to_north" vehsPerHour="20" begin="0" end="86400" type="car"/>
    <flow id="flow_J2_e2w" route="J2_east_to_west" vehsPerHour="20" begin="0" end="86400" type="car"/>
    <flow id="flow_J2_e2n" route="J2_east_to_north" vehsPerHour="20" begin="0" end="86400" type="car"/>
    <flow id="flow_J2_n2w" route="J2_north_to_west" vehsPerHour="20" begin="0" end="86400" type="car"/>
    <flow id="flow_J2_n2e" route="J2_north_to_east" vehsPerHour="20" begin="0" end="86400" type="car"/>
    
    <!-- J3: standard 4-way volumes remain unchanged (use original flows above or adjust) -->
    <flow id="J3_north_south" route="J3_north_to_south" vehsPerHour="20" begin="0" end="86400" type="car"/>
    <flow id="J3_north_east" route="J3_north_to_east" vehsPerHour="20" begin="0" end="86400" type="car"/>
    <flow id="J3_north_west" route="J3_north_to_west" vehsPerHour="20" begin="0" end="86400" type="car"/>
    
    <flow id="J3_south_north" route="J3_south_to_north" vehsPerHour="20" begin="0" end="86400" type="car"/>
    <flow id="J3_south_east" route="J3_south_to_east" vehsPerHour="20" begin="0" end="86400" type="car"/>
    <flow id="J3_south_west" route="J3_south_to_west" vehsPerHour="20" begin="0" end="86400" type="car"/>
    
    <flow id="J3_east_north" route="J3_east_to_north" vehsPerHour="20" begin="0" end="86400" type="car"/>
    <flow id="J3_east_south" route="J3_east_to_south" vehsPerHour="20" begin="0" end="86400" type="car"/>
    <flow id="J3_east_west" route="J3_east_to_west" vehsPerHour="20" begin="0" end="86400" type="car"/>
    
    <flow id="J3_west_north" route="J3_west_to_north" vehsPerHour="20" begin="0" end="86400" type="car"/>
    <flow id="J3_west_south" route="J3_west_to_south" vehsPerHour="20" begin="0" end="86400" type="car"/>
    <flow id="J3_west_east" route="J3_west_to_east" vehsPerHour="20" begin="0" end="86400" type="car"/>
    
</routes>
